# PondFish Ecosystem - Environment Variable Boundaries
# Traceability: PondFish Integration Specification v1 & DevOps Deployment Specification v1
# Note: DO NOT COMMIT REAL CREDENTIALS. Populate these values in your local .env file.

# -----------------------------------------------------------------------------
# 1. DATABASE (Authoritative PostgreSQL - 34 Tables)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pondfish
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=pondfish
PGSSL=false

# -----------------------------------------------------------------------------
# 2. APPLICATION RUNTIME & REALTIME
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000/api/v1/realtime

# -----------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
# Staff JWT / Session Secret (Worker Portal & Admin Portal email/password login)
JWT_SECRET=replace-with-secure-random-32-byte-hex-in-local-env
JWT_EXPIRES_IN=7d

# Firebase Admin SDK (Backend Token Verification for Customer Phone Auth OTP)
# Integration Spec Sec. 5
FIREBASE_PROJECT_ID=pondfish-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@pondfish-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Firebase Client SDK (Customer Mobile App & Public Web Phone OTP)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=pondfish-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=pondfish-dev

# -----------------------------------------------------------------------------
# 4. STORAGE ADAPTER (Production Provider: TBD)
# -----------------------------------------------------------------------------
# Development uses local filesystem driver. Production provider remains TBD.
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads

# -----------------------------------------------------------------------------
# 5. GPS TRACKING ADAPTER (OneLap Production Credentials: TBD)
# -----------------------------------------------------------------------------
# Development uses simulation driver. Production credentials remain TBD.
GPS_ADAPTER_MODE=simulation
ONELAP_API_URL=https://api.onelap.in/v1
ONELAP_API_KEY=TBD_ONELAP_API_KEY
ONELAP_VEHICLE_ID=TBD_VEHICLE_ID

# -----------------------------------------------------------------------------
# 6. PAYMENT GATEWAY (Razorpay)
# -----------------------------------------------------------------------------
# Integration Spec Sec. 4
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder
